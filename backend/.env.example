# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/restaurant-platform

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=http://localhost:3000

# Super Admin (created on first run if not exists)
SUPER_ADMIN_EMAIL=admin@platform.com
SUPER_ADMIN_PASSWORD=Admin@123456
SUPER_ADMIN_NAME=Platform Admin

# Telegram bot for staff order alerts (optional; from @BotFather)
TELEGRAM_BOT_TOKEN=
