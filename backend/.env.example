# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
# Set to "production" when deploying: disables the GraphQL playground, requires
# JWT_SECRET, and generates the GraphQL schema in memory.
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/restaurant-platform
# Production: your MongoDB Atlas SRV string
MONGODB_URI=mongodb://localhost:27017/restaurant-platform

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production - the server refuses to start without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ── Frontend ─────────────────────────────────────────────────────────────────
# Used for CORS and baked into table QR codes, so in production this must be
# the public site address (e.g. https://vivora.kr). Comma-separate to allow a
# second origin such as a staging domain.
FRONTEND_URL=http://localhost:3000

# ── Super admin (created on first run if missing) ────────────────────────────
# Choose your own password - anything written here would be a published one.
# Leave it blank in development and the server generates a random password and
# prints it once at startup. In production the server refuses to start without it.
SUPER_ADMIN_EMAIL=admin@platform.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Admin

# ── Billing (service fee) ────────────────────────────────────────────────────
# Flat monthly subscription per restaurant, and the currency it is charged in.
# Independent of what a restaurant prices its own menu in.
PLATFORM_FEE_AMOUNT=79000
PLATFORM_FEE_CURRENCY=KRW
# Shown to owners on the To'lov page so they know where to transfer.
PLATFORM_BANK_NAME=
PLATFORM_BANK_CARD=
PLATFORM_BANK_HOLDER=

# ── Telegram staff alerts (optional; token from @BotFather) ──────────────────
TELEGRAM_BOT_TOKEN=

# Menu translation (optional). Without a key the menu simply stays Uzbek.
# Create one at https://aistudio.google.com/apikey - the free tier covers a
# restaurant's menu comfortably, since text is only translated when edited.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Error alerts to Telegram (optional). Without ALERT_CHAT_ID nothing is sent.
# Send /start to your bot from the target chat, then read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates - group ids are negative.
TELEGRAM_ALERT_CHAT_ID=
# Optional: a topic id inside a supergroup, so several projects share one chat.
TELEGRAM_ALERT_THREAD_ID=
# Shown as the heading on every halert.
ALERT_PROJECT_NAME=Vivora
