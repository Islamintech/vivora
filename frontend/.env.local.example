# ── API ──────────────────────────────────────────────────────────────────────
# Production must use https:// and wss:// - a browser on an https page refuses
# to open a plain ws:// socket, which would silently break the kitchen screen.
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:4000/graphql

# Public site address, shown to owners as their QR link pattern.
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME=Vivora

# ── Cloudinary unsigned upload for menu photos (optional) ────────────────────
# Without these, photo upload is hidden and owners paste image URLs instead.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
